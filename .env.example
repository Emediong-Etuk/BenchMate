# All of these are server-only. None is ever sent to the browser
# (`npm run check:secrets` verifies the build).

# AssemblyAI (voice agent + protocol parsing)
ASSEMBLYAI_API_KEY=
# Verify against https://www.assemblyai.com/docs/llm-gateway/available-models (see NOTES.md C4)
LLM_GATEWAY_MODEL=claude-sonnet-4-6

# Sign-in (Auth.js). Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI: <your site>/api/auth/callback/google  (locally: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (Neon). The Vercel Neon integration sets this for you.
DATABASE_URL=
